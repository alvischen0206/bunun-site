{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/pets",
      "destination": "/pets/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/jinshunfa",
      "destination": "/public/jinshunfa/index.html"
    },
    {
      "source": "/jinshunfa/",
      "destination": "/public/jinshunfa/index.html"
    },
    {
      "source": "/jinshunfa/(.*)",
      "destination": "/public/jinshunfa/$1"
    },
    {
      "source": "/pets/",
      "destination": "/public/pets/index.html"
    },
    {
      "source": "/pets/(.*)",
      "destination": "/public/pets/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "/public/images/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
