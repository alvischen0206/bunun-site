{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/jinshunfa",
      "destination": "/public/jinshunfa/index.html"
    },
    {
      "source": "/jinshunfa/",
      "destination": "/public/jinshunfa/index.html"
    },
    {
      "source": "/jinshunfa/(.*)",
      "destination": "/public/jinshunfa/$1"
    },
    {
      "source": "/pets",
      "destination": "/public/pets/index.html"
    },
    {
      "source": "/pets/",
      "destination": "/public/pets/index.html"
    },
    {
      "source": "/pets/(.*)",
      "destination": "/public/pets/$1"
    },
    {
      "source": "/ai-workflow-onepager",
      "destination": "/public/ai-workflow-onepager/index.html"
    },
    {
      "source": "/ai-workflow-onepager/",
      "destination": "/public/ai-workflow-onepager/index.html"
    },
    {
      "source": "/ai-workflow-onepager/(.*)",
      "destination": "/public/ai-workflow-onepager/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "/public/images/$1"
    },
    {
      "source": "/Taiwan_travel",
      "destination": "/Taiwan_travel/index.html"
    },
    {
      "source": "/Taiwan_travel/",
      "destination": "/Taiwan_travel/index.html"
    },
    {
      "source": "/Taiwan_travel/(.*)",
      "destination": "/Taiwan_travel/$1"
    },
    {
      "source": "/japan_travel",
      "destination": "/Japan_travel/index.html"
    },
    {
      "source": "/japan_travel/",
      "destination": "/Japan_travel/index.html"
    },
    {
      "source": "/japan_travel/(.*)",
      "destination": "/Japan_travel/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
